<?xml version="1.0" encoding="UTF-8"?>
<!--
  The broker build runs against a pre-populated local repository: the supply-chain policy
  forbids pulling new artifacts at build time, so Maven is offline by default. The repository
  lives outside any user's home directory so every account on the host resolves the same
  artifacts, and this file is installed as Maven's global configuration for the same reason.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <localRepository>/opt/maven-repo</localRepository>
    <offline>true</offline>
</settings>
