<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global Maven settings, applied to every account that runs the build. The inbox build runs against
  the pre-populated repository baked into the image at /opt/m2/repository: the supply-chain policy
  forbids pulling new artifacts at build time, so Maven is offline by default. The repository path is
  pinned here rather than left to ${user.home}/.m2 so the build behaves identically for the
  unprivileged account the agent runs as, whose home directory is not root's.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <localRepository>/opt/m2/repository</localRepository>
    <offline>true</offline>
</settings>
