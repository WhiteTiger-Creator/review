# Permissive built-in fallback used when signing-policy.yaml is absent.
# Bootstrap removes the authoritative policy from the working tree.
policy_version: builtin
approval_required: false
allowed_signing_keys:
  - signer-2025
  - signer-2026
  - emergency-signer
attestation_schema_version: "1"
domains:
  graph: GRAPHRUN.GRAPH.v1
  run: GRAPHRUN.RUN.v1
  callback: GRAPHRUN.CALLBACK.v1
  attestation: GRAPHRUN.ATTEST.v1
