{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["EMPTY", "VALIDATING", "CORRELATING", "CHECKPOINTED", "READY_TO_PUBLISH", "PUBLISHED"]
    },
    "published": {
      "type": "boolean"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "committed_shards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "relevant_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "resumed_from_checkpoint": {
      "type": "boolean"
    }
  }
}
