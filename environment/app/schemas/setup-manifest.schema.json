{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "migration_instant", "services"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "migration_instant": { "type": "string" },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service_id", "status"],
        "additionalProperties": true,
        "properties": {
          "service_id": { "type": "string" },
          "status": { "type": "string" },
          "profile": {
            "type": "string",
            "enum": ["default", "fips", "legacy_full", "legacy_verify_only"]
          },
          "profile_path": { "type": "string" },
          "effective_uid": { "type": "integer" },
          "effective_gid": { "type": "integer" },
          "certificate_mounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["destination", "source"],
              "additionalProperties": false,
              "properties": {
                "destination": { "type": "string" },
                "source": { "type": "string" }
              }
            }
          },
          "report_sections": { "type": "array" },
          "setup_actions": { "type": "array" },
          "legacy": {
            "type": "object",
            "required": ["provider", "config_path"],
            "additionalProperties": true,
            "properties": {
              "provider": { "type": "string" },
              "config_path": { "type": "string" }
            }
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
