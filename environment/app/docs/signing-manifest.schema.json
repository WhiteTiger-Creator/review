{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphRunSigner signing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "policy_version",
    "policy_commit_id",
    "policy_digest",
    "mlflow_tarball_sha256",
    "callback_schema_sha256",
    "graph_digest",
    "run_digest",
    "terminal_callback_digest",
    "signing_key_id",
    "artifacts"
  ],
  "properties": {
    "manifest_schema_version": {
      "type": "string",
      "const": "1"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_commit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mlflow_tarball_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "callback_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "terminal_callback_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signing_key_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
