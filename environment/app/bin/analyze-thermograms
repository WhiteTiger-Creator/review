#!/bin/bash
set -euo pipefail

declare -A values=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --db|--api|--output)
      [ "$#" -ge 2 ] || { echo "missing value for $1" >&2; exit 2; }
      values["$1"]="$2"
      shift 2
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

DB="${values[--db]:-}"
API="${values[--api]:-}"
OUTPUT="${values[--output]:-}"
[ -n "$DB" ] && [ -n "$API" ] && [ -n "$OUTPUT" ] || {
  echo "--db, --api, and --output are required" >&2
  exit 2
}

work="$(mktemp -d "${TMPDIR:-/tmp}/thermogram-audit.XXXXXX")"
trap 'rm -rf "$work"' EXIT
candidate="$work/candidate.json"

java -jar /app/analyzer/build/analyzer.jar \
  --db "$DB" \
  --api "$API" \
  --output "$candidate"

/app/bin/thermal-evidence-auditor \
  --db "$DB" \
  --report "$candidate" \
  --output "$OUTPUT"
