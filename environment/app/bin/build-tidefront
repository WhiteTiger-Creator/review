#!/bin/bash
set -euo pipefail
export LC_ALL=C
export TZ=UTC
root=${APP_ROOT:-/app}
rm -rf "$root/dist"
mkdir -p "$root/dist/bin" "$root/dist/lib"
make -C "$root/libastro" clean all \
  CFLAGS='-O2 -std=c11 -fPIC -Wall -Wextra -Werror -ffile-prefix-map=/app=. -fdebug-prefix-map=/app=.' \
  LDFLAGS='-shared -Wl,--build-id=none'
install -m 0755 "$root/libastro/libastrotime.so" "$root/dist/lib/libastrotime.so.1"
ln -s libastrotime.so.1 "$root/dist/lib/libastrotime.so"
cd "$root"
CGO_ENABLED=1 go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o "$root/dist/bin/tidefront" ./cmd/tidefront
chmod 0755 "$root/dist/bin/tidefront"
