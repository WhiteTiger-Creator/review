#!/usr/bin/env bash
set -euo pipefail
BUNDLE="" DEST=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bundle) BUNDLE="$2"; shift 2 ;;
    --destination) DEST="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
jq --arg dest "${DEST}" '.mounts[] | select(.destination == $dest)' "${BUNDLE}/config.json"
