#!/usr/bin/env bash
set -euo pipefail
REPORT_INDEX="/app/data/report/decision-index.json"
REPORT="/app/data/report/migration-report.md"
OCI_ROOT="/app/data/oci"
CERT_ROOT="/app/data/certs"
PROVIDER_ROOT="/app/data/providers"
STATE="/app/data/state/state.json"
OUTPUT="/output"
MIGRATION_INSTANT="${HARBORSEAL_MIGRATION_INSTANT:-2026-04-01T00:00:00Z}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --report-index) REPORT_INDEX="$2"; shift 2 ;;
    --report) REPORT="$2"; shift 2 ;;
    --oci-root) OCI_ROOT="$2"; shift 2 ;;
    --cert-root) CERT_ROOT="$2"; shift 2 ;;
    --provider-root) PROVIDER_ROOT="$2"; shift 2 ;;
    --state) STATE="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
mkdir -p "${OUTPUT}/profiles" "${OUTPUT}/.staging"
export OPENSSL_CONF= OPENSSL_MODULES=/app/data/providers/modules
export HARBORSEAL_MIGRATION_INSTANT="${MIGRATION_INSTANT}"
LIBS=(
  /app/lib/json.awk
  /app/lib/canonical.awk
  /app/lib/report.awk
  /app/lib/runtime.awk
  /app/lib/paths.awk
  /app/lib/users.awk
  /app/lib/providers.awk
  /app/lib/manifest.awk
  /app/lib/state.awk
  /app/lib/harborseal.awk
)
awk_args=()
for f in "${LIBS[@]}"; do awk_args+=(-f "$f"); done
mapfile -t bundles < <(find "${OCI_ROOT}" -mindepth 1 -maxdepth 1 -type d | sort)
gawk "${awk_args[@]}" \
  -v report_index="${REPORT_INDEX}" \
  -v output_dir="${OUTPUT}/profiles" \
  -v manifest_path="${OUTPUT}/setup-manifest.json" \
  -v state_path="${STATE}" \
  -v migration_instant="${MIGRATION_INSTANT}" \
  -e 'BEGIN {
    hs_reset()
    hs_configure("", "migration_instant", migration_instant)
    hs_load_report_index(report_index)
    for (i = 1; i < ARGC; i++) {
      bundle = ARGV[i]
      config = bundle "/config.json"
      delete ARGV[i]
      hs_resolve_service(bundle, config, output_dir)
    }
    hs_emit_manifest(manifest_path)
    hs_state_status = "FINISHED"
    hs_save_state(state_path)
  }' "${bundles[@]}"
