@query schedule_meta
SELECT key,value FROM schedule_meta ORDER BY key
@end
@query maintenance_order
SELECT order_id,site_alias,service_class,family_code,state,not_before,not_after,source_epoch,precedence_rank,ack_weight_required,disabled FROM maintenance_order ORDER BY order_id
@end
@query ack_role
SELECT role_code,ack_weight,work_group FROM ack_role ORDER BY role_code
@end
@query ack_event
SELECT event_id,order_id,operator_id,role_code,event_kind,event_epoch,precedence_rank FROM ack_event ORDER BY order_id,operator_id,role_code,event_epoch,event_id
@end
@query service_slot
SELECT slot_id,order_id,socket_candidate_id,body_tier_code,service_lane,source_epoch,precedence_rank,effective_from,effective_to,disabled FROM service_slot ORDER BY slot_id
@end
@query schedule_rule
SELECT name,rule_ref,expected_class,ordinal FROM schedule_rule ORDER BY ordinal,name
@end
