@query change_meta
SELECT key,value FROM change_meta ORDER BY key
@end
@query change_ticket
SELECT ticket_id,site_alias,incident_code,family_code,state,not_before,not_after,source_epoch,precedence_rank,quorum_required,disabled FROM change_ticket ORDER BY ticket_id
@end
@query approval_role
SELECT role_code,quorum_weight,exclusive_group FROM approval_role ORDER BY role_code
@end
@query approval_event
SELECT event_id,ticket_id,approver_id,role_code,event_kind,event_epoch,precedence_rank FROM approval_event ORDER BY ticket_id,approver_id,role_code,event_epoch,event_id
@end
@query activation_candidate
SELECT activation_id,ticket_id,socket_candidate_id,body_tier_code,release_lane,source_epoch,precedence_rank,effective_from,effective_to,disabled FROM activation_candidate ORDER BY activation_id
@end
@query authorization_rule
SELECT name,rule_ref,expected_class,ordinal FROM authorization_rule ORDER BY ordinal,name
@end
