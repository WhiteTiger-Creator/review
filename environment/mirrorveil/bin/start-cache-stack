#!/bin/bash
set -euo pipefail

ROOT=/srv/mirrorveil
# shellcheck source=/dev/null
source "${ROOT}/policy/topology.conf"
# shellcheck source=/dev/null
source "${ROOT}/policy/cache-limits.conf"

umask 022

alive_pid() {
  local pid_file="$1"
  if [[ -f "${pid_file}" ]]; then
    local pid
    pid="$(tr -d ' \n' < "${pid_file}")"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    rm -f "${pid_file}"
  fi
  return 1
}

refuse_if_live() {
  local name="$1"
  local pid_file="$2"
  if alive_pid "${pid_file}"; then
    echo "refusing to start ${name}: already running (pid $(tr -d ' \n' < "${pid_file}"))" >&2
    exit 1
  fi
}

prepare_runtime() {
  mkdir -p \
    "${PRIMARY_PREFIX}/logs" \
    "${SECONDARY_PREFIX}/logs" \
    "${VARNISH_WORK_DIR}" \
    "${RUNTIME_ROOT}/tmp"
  chmod 755 "${RUNTIME_ROOT}"
  chmod 755 "${PRIMARY_PREFIX}" "${SECONDARY_PREFIX}" "${VARNISH_WORK_DIR}"
  chmod 755 "${PRIMARY_PREFIX}/logs" "${SECONDARY_PREFIX}/logs"
  if id varnish >/dev/null 2>&1; then
    chown -R varnish:varnish "${VARNISH_WORK_DIR}"
  fi
  if [[ ! -f "${VARNISH_SECRET_FILE}" ]]; then
    dd if=/dev/urandom of="${VARNISH_SECRET_FILE}" bs=32 count=1 status=none
    chmod 600 "${VARNISH_SECRET_FILE}"
  fi
  if id varnish >/dev/null 2>&1; then
    chown varnish:varnish "${VARNISH_SECRET_FILE}"
  fi
}

poll_ms() {
  sleep "$(awk -v ms="$1" 'BEGIN { printf "%.3f", ms/1000 }')"
}

wait_origin_ready() {
  local url="$1"
  local timeout_sec="$2"
  local deadline=$((SECONDS + timeout_sec))
  while (( SECONDS < deadline )); do
    if curl -fsS --max-time 1 -H "Host: health.mirrorveil.invalid" "${url}" >/dev/null 2>&1; then
      return 0
    fi
    poll_ms "${ORIGIN_HEALTH_POLL_MS}"
  done
  return 1
}

wait_cache_ready() {
  local timeout_sec="$1"
  local deadline=$((SECONDS + timeout_sec))
  while (( SECONDS < deadline )); do
    if varnishadm -n "${VARNISH_WORK_DIR}" ping >/dev/null 2>&1; then
      local code
      code="$(curl -sS --max-time 1 -o /dev/null -w '%{http_code}' \
        -H "Host: readiness.check.invalid" \
        "http://${CACHE_ADDR}:${CACHE_PORT}/" || true)"
      if [[ -n "${code}" && "${code}" != "000" ]]; then
        return 0
      fi
    fi
    poll_ms "${STACK_READY_POLL_MS}"
  done
  return 1
}

refuse_if_live primary "${PRIMARY_PID_FILE}"
refuse_if_live secondary "${SECONDARY_PID_FILE}"
refuse_if_live varnish "${VARNISH_PID_FILE}"

prepare_runtime

nginx -c "${ROOT}/nginx/primary.conf" -p "${PRIMARY_PREFIX}/"
nginx -c "${ROOT}/nginx/secondary.conf" -p "${SECONDARY_PREFIX}/"

if ! wait_origin_ready "http://${PRIMARY_ADDR}:${PRIMARY_PORT}${HEALTH_PATH}" "${ORIGIN_HEALTH_TIMEOUT_SEC}"; then
  echo "primary origin failed readiness" >&2
  exit 1
fi
if ! wait_origin_ready "http://${SECONDARY_ADDR}:${SECONDARY_PORT}${HEALTH_PATH}" "${ORIGIN_HEALTH_TIMEOUT_SEC}"; then
  echo "secondary origin failed readiness" >&2
  exit 1
fi

varnishd \
  -n "${VARNISH_WORK_DIR}" \
  -P "${VARNISH_PID_FILE}" \
  -a "${CACHE_ADDR}:${CACHE_PORT}" \
  -T "${MGMT_ADDR}:${MGMT_PORT}" \
  -f "${ENTRY_VCL}" \
  -S "${VARNISH_SECRET_FILE}" \
  -s "${VARNISH_STORAGE_NAME}=${VARNISH_STORAGE_SPEC}"

if ! wait_cache_ready "${STACK_READY_TIMEOUT_SEC}"; then
  echo "varnish failed client readiness" >&2
  exit 1
fi

# Activate the installed policy generation (content-addressed once reload-cache-policy is complete).
"${ROOT}/bin/reload-cache-policy"

exit 0
