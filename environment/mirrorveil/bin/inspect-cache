#!/bin/bash
set -euo pipefail

ROOT=/srv/mirrorveil
# shellcheck source=/dev/null
source "${ROOT}/policy/topology.conf"

alive_pid() {
  local pid_file="$1"
  if [[ -f "${pid_file}" ]]; then
    local pid
    pid="$(tr -d ' \n' < "${pid_file}")"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      echo "running"
      return 0
    fi
  fi
  echo "stopped"
}

normalize_health() {
  case "$1" in
    Healthy|healthy) echo "Healthy" ;;
    Sick|sick) echo "Sick" ;;
    *) echo "${1:-unknown}" ;;
  esac
}

varnish_state="$(alive_pid "${VARNISH_PID_FILE}")"
primary_state="$(alive_pid "${PRIMARY_PID_FILE}")"
secondary_state="$(alive_pid "${SECONDARY_PID_FILE}")"

active_vcl="none"
storage_name="${VARNISH_STORAGE_NAME}"
primary_probe="unknown"
secondary_probe="unknown"
preferred="unknown"
uptime_sec="0"
cache_objects="0"

if [[ "${varnish_state}" == "running" ]]; then
  active_vcl="$(varnishadm -n "${VARNISH_WORK_DIR}" vcl.list 2>/dev/null | awk '/^active/ {print $NF; exit}')"
  if [[ -z "${active_vcl}" ]]; then
    active_vcl="unknown"
  fi
  blist="$(varnishadm -n "${VARNISH_WORK_DIR}" backend.list 2>/dev/null || true)"
  primary_raw="$(printf '%s\n' "${blist}" | awk 'tolower($1) ~ /primary_origin/ {print $(NF-3); exit}')"
  secondary_raw="$(printf '%s\n' "${blist}" | awk 'tolower($1) ~ /secondary_origin/ {print $(NF-3); exit}')"
  # Columns: name admin probe health last-change(multi-word). Health is the token before weekday.
  primary_raw="$(printf '%s\n' "${blist}" | awk 'tolower($1) ~ /primary_origin/ {
    for (i=1;i<=NF;i++) if ($i ~ /^(healthy|sick|Healthy|Sick)$/) { print $i; exit }
  }')"
  secondary_raw="$(printf '%s\n' "${blist}" | awk 'tolower($1) ~ /secondary_origin/ {
    for (i=1;i<=NF;i++) if ($i ~ /^(healthy|sick|Healthy|Sick)$/) { print $i; exit }
  }')"
  primary_probe="$(normalize_health "${primary_raw}")"
  secondary_probe="$(normalize_health "${secondary_raw}")"
  if [[ "${primary_probe}" == "Healthy" ]]; then
    preferred="primary_origin"
  elif [[ "${secondary_probe}" == "Healthy" ]]; then
    preferred="secondary_origin"
  else
    preferred="none"
  fi
  uptime_sec="$(varnishstat -n "${VARNISH_WORK_DIR}" -1 -f MAIN.uptime 2>/dev/null | awk 'NR==1 {print $2}')"
  cache_objects="$(varnishstat -n "${VARNISH_WORK_DIR}" -1 -f MAIN.n_object 2>/dev/null | awk 'NR==1 {print $2}')"
  uptime_sec="${uptime_sec:-0}"
  cache_objects="${cache_objects:-0}"
fi

printf 'varnish_state=%s client_port=%s management_port=%s active_vcl=%s storage=%s\n' \
  "${varnish_state}" "${CACHE_PORT}" "${MGMT_PORT}" "${active_vcl}" "${storage_name}"
printf 'primary_state=%s primary_listen=%s:%s secondary_state=%s secondary_listen=%s:%s\n' \
  "${primary_state}" "${PRIMARY_ADDR}" "${PRIMARY_PORT}" \
  "${secondary_state}" "${SECONDARY_ADDR}" "${SECONDARY_PORT}"
printf 'primary_probe=%s secondary_probe=%s preferred_backend=%s\n' \
  "${primary_probe}" "${secondary_probe}" "${preferred}"
printf 'uptime_sec=%s cache_objects=%s\n' "${uptime_sec}" "${cache_objects}"
