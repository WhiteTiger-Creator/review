#!/bin/bash
set -euo pipefail

ROOT=/srv/mirrorveil
# shellcheck source=/dev/null
source "${ROOT}/policy/topology.conf"
# shellcheck source=/dev/null
source "${ROOT}/policy/control.conf"
# shellcheck source=/dev/null
source "${ROOT}/policy/cache-limits.conf"

usage() {
  echo "usage: cache-control origin-down|origin-up primary|secondary" >&2
  echo "       cache-control purge HOST URL" >&2
  echo "       cache-control ban-class HOST CLASS" >&2
  exit 2
}

poll_ms() {
  sleep "$(awk -v ms="$1" 'BEGIN { printf "%.3f", ms/1000 }')"
}

origin_pid_file() {
  case "$1" in
    primary) echo "${PRIMARY_PID_FILE}" ;;
    secondary) echo "${SECONDARY_PID_FILE}" ;;
    *) return 1 ;;
  esac
}

origin_conf() {
  case "$1" in
    primary) echo "${ROOT}/nginx/primary.conf" ;;
    secondary) echo "${ROOT}/nginx/secondary.conf" ;;
    *) return 1 ;;
  esac
}

origin_prefix() {
  case "$1" in
    primary) echo "${PRIMARY_PREFIX}" ;;
    secondary) echo "${SECONDARY_PREFIX}" ;;
    *) return 1 ;;
  esac
}

origin_url() {
  case "$1" in
    primary) echo "http://${PRIMARY_ADDR}:${PRIMARY_PORT}${HEALTH_PATH}" ;;
    secondary) echo "http://${SECONDARY_ADDR}:${SECONDARY_PORT}${HEALTH_PATH}" ;;
    *) return 1 ;;
  esac
}

wait_origin_state() {
  local which="$1"
  local want="$2"
  local url
  url="$(origin_url "${which}")"
  local deadline=$((SECONDS + ORIGIN_HEALTH_TIMEOUT_SEC))
  while (( SECONDS < deadline )); do
    if curl -fsS --max-time 1 -H "Host: health.mirrorveil.invalid" "${url}" >/dev/null 2>&1; then
      if [[ "${want}" == "up" ]]; then
        return 0
      fi
    else
      if [[ "${want}" == "down" ]]; then
        return 0
      fi
    fi
    poll_ms "${ORIGIN_HEALTH_POLL_MS}"
  done
  return 1
}

origin_down() {
  local which="$1"
  local pid_file
  pid_file="$(origin_pid_file "${which}")"
  if [[ -f "${pid_file}" ]]; then
    local pid
    pid="$(tr -d ' \n' < "${pid_file}")"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
      local deadline=$((SECONDS + PROCESS_STOP_TIMEOUT_SEC))
      while (( SECONDS < deadline )); do
        if ! kill -0 "${pid}" 2>/dev/null; then
          break
        fi
        poll_ms 100
      done
      if kill -0 "${pid}" 2>/dev/null; then
        kill -9 "${pid}" 2>/dev/null || true
      fi
    fi
    rm -f "${pid_file}"
  fi
  wait_origin_state "${which}" down
}

origin_up() {
  local which="$1"
  local pid_file conf prefix
  pid_file="$(origin_pid_file "${which}")"
  conf="$(origin_conf "${which}")"
  prefix="$(origin_prefix "${which}")"
  if [[ -f "${pid_file}" ]]; then
    local pid
    pid="$(tr -d ' \n' < "${pid_file}")"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      wait_origin_state "${which}" up
      return 0
    fi
    rm -f "${pid_file}"
  fi
  mkdir -p "${prefix}/logs"
  nginx -c "${conf}" -p "${prefix}/"
  wait_origin_state "${which}" up
}

[[ $# -ge 1 ]] || usage
cmd="$1"
shift || true

case "${cmd}" in
  origin-down)
    [[ $# -eq 1 ]] || usage
    origin_down "$1"
    ;;
  origin-up)
    [[ $# -eq 1 ]] || usage
    origin_up "$1"
    ;;
  purge)
    [[ $# -eq 2 ]] || usage
    host="$1"
    url="$2"
    curl -sS --max-time 5 \
      -X PURGE \
      -H "Host: ${host}" \
      -H "${CONTROL_HEADER}: ${CONTROL_MARKER}" \
      "http://${CACHE_ADDR}:${CACHE_PORT}${url}"
    echo
    ;;
  ban-class)
    [[ $# -eq 2 ]] || usage
    host="$1"
    class="$2"
    curl -sS --max-time 5 \
      -X BAN \
      -H "Host: ${host}" \
      -H "${CONTROL_HEADER}: ${CONTROL_MARKER}" \
      -H "${BAN_CLASS_HEADER}: ${class}" \
      "http://${CACHE_ADDR}:${CACHE_PORT}/"
    echo
    ;;
  *)
    usage
    ;;
esac
