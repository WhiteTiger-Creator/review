#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 3 ]; then
    echo "usage: run-runtime ROOT baseline|v3 settlement|refund|reconcile" >&2
    exit 64
fi

root=$1
mode=$2
request=$3
case "$request" in
    settlement|refund|reconcile) ;;
    *) echo "unknown request: $request" >&2; exit 65 ;;
esac

loader=/lib64/ld-linux-x86-64.so.2
app=/opt/ledger/bin/ledger-gateway
input=/opt/ledger/requests/$request.req
case "$mode" in
    baseline)
        chroot "$root" "$loader" --glibc-hwcaps-mask "" "$app" "$input"
        ;;
    v3)
        chroot "$root" "$loader" --inhibit-cache --library-path /opt/ledger/lib --glibc-hwcaps-prepend x86-64-v3 "$app" "$input"
        ;;
    *)
        echo "unknown mode: $mode" >&2
        exit 66
        ;;
esac
