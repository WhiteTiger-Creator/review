#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ] || [[ "$1" != /* ]] || [ "$1" = "/" ]; then
    echo "usage: rebuild-runtime ABSOLUTE_ROOT" >&2
    exit 64
fi

root=$1
make -C /app clean all
rm -rf -- "$root"
install -d "$root/opt/ledger/bin" "$root/opt/ledger/lib" \
    "$root/opt/ledger/lib/x86-64-v3" "$root/opt/ledger/requests" \
    "$root/etc/ld.so.conf.d" "$root/lib/x86_64-linux-gnu" "$root/lib64"

install -m 0755 /app/build/ledger-gateway "$root/opt/ledger/bin/ledger-gateway"
install -m 0644 /app/build/libledger_rules.so.1.0 "$root/opt/ledger/lib/"
install -m 0644 /app/build/libledger_policy.so.2.0 "$root/opt/ledger/lib/"
ln -sfn libledger_rules.so.1.0 "$root/opt/ledger/lib/libledger_rules.so.1"
ln -sfn libledger_policy.so.2.0 "$root/opt/ledger/lib/libledger_policy.so.2"

install -m 0644 /app/build/libledger_rules.so.1.1 "$root/opt/ledger/lib/x86-64-v3/"
install -m 0644 /app/build/libledger_policy.so.2.1 "$root/opt/ledger/lib/x86-64-v3/"
ln -sfn /opt/ledger/lib/libledger_rules.so.1.0 "$root/opt/ledger/lib/x86-64-v3/libledger_rules.so.1"
ln -sfn libledger_policy.so.2.1 "$root/opt/ledger/lib/x86-64-v3/libledger_policy.so.2"

install -m 0644 /app/requests/*.req "$root/opt/ledger/requests/"
printf 'include /etc/ld.so.conf.d/*.conf\n' > "$root/etc/ld.so.conf"
install -m 0644 /app/config/ledger-gateway.conf "$root/etc/ld.so.conf.d/ledger-gateway.conf"

loader=$(readlink -f /lib64/ld-linux-x86-64.so.2)
libc=$(readlink -f /lib/x86_64-linux-gnu/libc.so.6)
install -m 0755 "$loader" "$root/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"
ln -sfn ../lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 "$root/lib64/ld-linux-x86-64.so.2"
install -m 0755 "$libc" "$root/lib/x86_64-linux-gnu/libc.so.6"

ldconfig -r "$root"
