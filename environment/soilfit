#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo "usage: /app/bin/soilfit DATABASE" >&2
    exit 2
fi

database="$1"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

sqlite3 -header -separator $'\t' "$database" "SELECT plot,depth,temp,moisture,clay,input,f_input FROM layers ORDER BY plot,depth" > "$scratch/layers.tsv"
sqlite3 -header -separator $'\t' "$database" "SELECT plot,moisture_scale,oxygen_scale FROM forcing ORDER BY plot" > "$scratch/forcing.tsv"
sqlite3 -header -separator $'\t' "$database" "SELECT plot,depth,carbon,respiration,f14c,sigma_c,sigma_r,sigma_f,fold FROM observations ORDER BY plot,depth" > "$scratch/observations.tsv"
sqlite3 -header -separator $'\t' "$database" "SELECT parameter,lower,upper FROM bounds ORDER BY parameter" > "$scratch/bounds.tsv"
sqlite3 -header -separator $'\t' "$database" "SELECT weight FROM penalty_grid ORDER BY weight" > "$scratch/penalty_grid.tsv"

gawk -f /app/src/invert.awk "$scratch/layers.tsv" "$scratch/forcing.tsv" "$scratch/observations.tsv" "$scratch/bounds.tsv" "$scratch/penalty_grid.tsv" > "$scratch/results.sql"
test -s "$scratch/results.sql"
sqlite3 -bail "$database" < "$scratch/results.sql"
