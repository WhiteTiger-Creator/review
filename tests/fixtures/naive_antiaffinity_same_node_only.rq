PREFIX : <http://ex.org/k8s#>
SELECT ?pod
       ((COUNT(DISTINCT ?node) > 0) AS ?schedulable)
       (COUNT(DISTINCT ?node) AS ?feasible_node_count)
WHERE {
  ?pod :pending true .
  OPTIONAL {
    ?node a :Node .
    FILTER NOT EXISTS {
      ?node :hasTaint ?taint .
      ?taint :key ?xk ; :value ?xv ; :effect ?te .
      FILTER(?te = "NoSchedule" || ?te = "NoExecute")
      FILTER NOT EXISTS {
        ?pod :hasToleration ?tol .
        ?tol :key ?tk ; :operator ?top ; :value ?tv ; :effect ?tef .
        FILTER(?tef = "" || ?tef = ?te)
        FILTER((?tk = "" && ?top = "Exists")
               || (?tk = ?xk && (?top = "Exists"
                                 || (?top = "Equal" && ?tv = ?xv))))
      }
    }
    FILTER NOT EXISTS {
      ?pod :requiresLabel ?req .
      FILTER NOT EXISTS { ?node :hasLabel ?req }
    }
    FILTER NOT EXISTS {
      ?pod :hasAntiAffinity ?aa2 .
      ?aa2 :selectorLabel ?sel .
      ?other :hasPodLabel ?sel .
      ?other :placedOn ?node .
      FILTER NOT EXISTS {
        ?node :hasTaint ?xt .
        ?xt :key ?xtk ; :value ?xtv ; :effect "NoExecute" .
        FILTER NOT EXISTS {
          ?other :hasToleration ?otol .
          ?otol :key ?ok ; :operator ?oop ; :value ?ov ; :effect ?oef .
          FILTER(?oef = "" || ?oef = "NoExecute")
          FILTER((?ok = "" && ?oop = "Exists")
                 || (?ok = ?xtk && (?oop = "Exists"
                                    || (?oop = "Equal" && ?ov = ?xtv))))
        }
      }
    }
  }
}
GROUP BY ?pod
