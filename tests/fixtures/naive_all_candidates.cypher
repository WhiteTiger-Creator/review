MATCH (cl:Client)
OPTIONAL MATCH (x:Candidate)-[:OF]->(cl), (x)-[:FROM_SERVER]->(sx:Server)
  WHERE true
WITH cl, count(x) AS m
WITH cl, m, CASE WHEN (2 * 0 < m AND EXISTS { MATCH (q1_k:Candidate)-[:OF]->(cl), (q1_k)-[:FROM_SERVER]->(q1_s:Server) WHERE true AND COUNT { MATCH (q2_k:Candidate)-[:OF]->(cl), (q2_k)-[:FROM_SERVER]->(q2_s:Server) WHERE true AND q2_k.lo <= q1_k.lo AND q2_k.hi >= q1_k.lo } >= (m - 0) } AND COUNT { MATCH (q3_k:Candidate)-[:OF]->(cl), (q3_k)-[:FROM_SERVER]->(q3_s:Server) WHERE true AND NOT (EXISTS { MATCH (q4_k:Candidate)-[:OF]->(cl), (q4_k)-[:FROM_SERVER]->(q4_s:Server) WHERE true AND q4_k.lo <= q3_k.offset AND COUNT { MATCH (q6_k:Candidate)-[:OF]->(cl), (q6_k)-[:FROM_SERVER]->(q6_s:Server) WHERE true AND q6_k.lo <= q4_k.lo AND q6_k.hi >= q4_k.lo } >= (m - 0) } AND EXISTS { MATCH (q5_k:Candidate)-[:OF]->(cl), (q5_k)-[:FROM_SERVER]->(q5_s:Server) WHERE true AND q5_k.hi >= q3_k.offset AND COUNT { MATCH (q7_k:Candidate)-[:OF]->(cl), (q7_k)-[:FROM_SERVER]->(q7_s:Server) WHERE true AND q7_k.lo <= q5_k.hi AND q7_k.hi >= q5_k.hi } >= (m - 0) }) } <= 0) THEN 0 WHEN (2 * 1 < m AND EXISTS { MATCH (q8_k:Candidate)-[:OF]->(cl), (q8_k)-[:FROM_SERVER]->(q8_s:Server) WHERE true AND COUNT { MATCH (q9_k:Candidate)-[:OF]->(cl), (q9_k)-[:FROM_SERVER]->(q9_s:Server) WHERE true AND q9_k.lo <= q8_k.lo AND q9_k.hi >= q8_k.lo } >= (m - 1) } AND COUNT { MATCH (q10_k:Candidate)-[:OF]->(cl), (q10_k)-[:FROM_SERVER]->(q10_s:Server) WHERE true AND NOT (EXISTS { MATCH (q11_k:Candidate)-[:OF]->(cl), (q11_k)-[:FROM_SERVER]->(q11_s:Server) WHERE true AND q11_k.lo <= q10_k.offset AND COUNT { MATCH (q13_k:Candidate)-[:OF]->(cl), (q13_k)-[:FROM_SERVER]->(q13_s:Server) WHERE true AND q13_k.lo <= q11_k.lo AND q13_k.hi >= q11_k.lo } >= (m - 1) } AND EXISTS { MATCH (q12_k:Candidate)-[:OF]->(cl), (q12_k)-[:FROM_SERVER]->(q12_s:Server) WHERE true AND q12_k.hi >= q10_k.offset AND COUNT { MATCH (q14_k:Candidate)-[:OF]->(cl), (q14_k)-[:FROM_SERVER]->(q14_s:Server) WHERE true AND q14_k.lo <= q12_k.hi AND q14_k.hi >= q12_k.hi } >= (m - 1) }) } <= 1) THEN 1 WHEN (2 * 2 < m AND EXISTS { MATCH (q15_k:Candidate)-[:OF]->(cl), (q15_k)-[:FROM_SERVER]->(q15_s:Server) WHERE true AND COUNT { MATCH (q16_k:Candidate)-[:OF]->(cl), (q16_k)-[:FROM_SERVER]->(q16_s:Server) WHERE true AND q16_k.lo <= q15_k.lo AND q16_k.hi >= q15_k.lo } >= (m - 2) } AND COUNT { MATCH (q17_k:Candidate)-[:OF]->(cl), (q17_k)-[:FROM_SERVER]->(q17_s:Server) WHERE true AND NOT (EXISTS { MATCH (q18_k:Candidate)-[:OF]->(cl), (q18_k)-[:FROM_SERVER]->(q18_s:Server) WHERE true AND q18_k.lo <= q17_k.offset AND COUNT { MATCH (q20_k:Candidate)-[:OF]->(cl), (q20_k)-[:FROM_SERVER]->(q20_s:Server) WHERE true AND q20_k.lo <= q18_k.lo AND q20_k.hi >= q18_k.lo } >= (m - 2) } AND EXISTS { MATCH (q19_k:Candidate)-[:OF]->(cl), (q19_k)-[:FROM_SERVER]->(q19_s:Server) WHERE true AND q19_k.hi >= q17_k.offset AND COUNT { MATCH (q21_k:Candidate)-[:OF]->(cl), (q21_k)-[:FROM_SERVER]->(q21_s:Server) WHERE true AND q21_k.lo <= q19_k.hi AND q21_k.hi >= q19_k.hi } >= (m - 2) }) } <= 2) THEN 2 WHEN (2 * 3 < m AND EXISTS { MATCH (q22_k:Candidate)-[:OF]->(cl), (q22_k)-[:FROM_SERVER]->(q22_s:Server) WHERE true AND COUNT { MATCH (q23_k:Candidate)-[:OF]->(cl), (q23_k)-[:FROM_SERVER]->(q23_s:Server) WHERE true AND q23_k.lo <= q22_k.lo AND q23_k.hi >= q22_k.lo } >= (m - 3) } AND COUNT { MATCH (q24_k:Candidate)-[:OF]->(cl), (q24_k)-[:FROM_SERVER]->(q24_s:Server) WHERE true AND NOT (EXISTS { MATCH (q25_k:Candidate)-[:OF]->(cl), (q25_k)-[:FROM_SERVER]->(q25_s:Server) WHERE true AND q25_k.lo <= q24_k.offset AND COUNT { MATCH (q27_k:Candidate)-[:OF]->(cl), (q27_k)-[:FROM_SERVER]->(q27_s:Server) WHERE true AND q27_k.lo <= q25_k.lo AND q27_k.hi >= q25_k.lo } >= (m - 3) } AND EXISTS { MATCH (q26_k:Candidate)-[:OF]->(cl), (q26_k)-[:FROM_SERVER]->(q26_s:Server) WHERE true AND q26_k.hi >= q24_k.offset AND COUNT { MATCH (q28_k:Candidate)-[:OF]->(cl), (q28_k)-[:FROM_SERVER]->(q28_s:Server) WHERE true AND q28_k.lo <= q26_k.hi AND q28_k.hi >= q26_k.hi } >= (m - 3) }) } <= 3) THEN 3 ELSE -1 END AS fstar
OPTIONAL MATCH (c:Candidate)-[:OF]->(cl), (c)-[:FROM_SERVER]->(sc:Server)
  WHERE true AND fstar >= 0 AND (EXISTS { MATCH (q29_k:Candidate)-[:OF]->(cl), (q29_k)-[:FROM_SERVER]->(q29_s:Server) WHERE true AND q29_k.lo <= c.offset AND COUNT { MATCH (q31_k:Candidate)-[:OF]->(cl), (q31_k)-[:FROM_SERVER]->(q31_s:Server) WHERE true AND q31_k.lo <= q29_k.lo AND q31_k.hi >= q29_k.lo } >= (m - fstar) } AND EXISTS { MATCH (q30_k:Candidate)-[:OF]->(cl), (q30_k)-[:FROM_SERVER]->(q30_s:Server) WHERE true AND q30_k.hi >= c.offset AND COUNT { MATCH (q32_k:Candidate)-[:OF]->(cl), (q32_k)-[:FROM_SERVER]->(q32_s:Server) WHERE true AND q32_k.lo <= q30_k.hi AND q32_k.hi >= q30_k.hi } >= (m - fstar) })
WITH cl, m, count(c) AS truechimer_count,
     min(CASE WHEN c IS NULL THEN NULL ELSE CAST(sc.stratum + 100 AS STRING) + '|' + CAST(sc.root_dispersion + 1000000000000 AS STRING) + '|' + sc.name END) AS peer_key
RETURN cl.name AS client,
       CASE WHEN peer_key IS NULL THEN 16
            ELSE CAST(substr(peer_key, 1, 3) AS INT64) - 100 + 1 END AS stratum,
       CASE WHEN peer_key IS NULL THEN 'NONE'
            ELSE substr(peer_key, 19, 200) END AS system_peer,
       truechimer_count,
       m - truechimer_count AS falseticker_count
