MATCH (sa:Switch)-[:HAS_PORT]->(p:Port)-[:LINK]-(q:Port)<-[:HAS_PORT]-(sb:Switch)
WHERE p.admin_up AND p.link_up AND p.aggregatable
  AND q.admin_up AND q.link_up
  AND p.partner_system_id = sb.system_id
  AND p.partner_key = q.actor_key
WITH sa, p, q, sb,
     CASE WHEN q.aggregatable
           AND q.partner_system_id = sa.system_id
           AND q.partner_key = p.actor_key THEN 1 ELSE 0 END AS qagree
WITH sa.id AS sxid, p.actor_key AS akey, p.partner_system_id AS psid,
     count(*) AS na, sum(qagree) AS nmut,
     count(DISTINCT q.actor_key) AS dkey,
     count(DISTINCT q.partner_system_id) AS dpsid,
     min(sb.id) AS ysw, min(q.actor_key) AS ykey,
     min(q.partner_system_id) AS ypsid
OPTIONAL MATCH (sc:Switch)-[:HAS_PORT]->(r:Port)-[:LINK]-(w:Port)<-[:HAS_PORT]-(sd:Switch)
WHERE nmut = na AND dkey = 1 AND dpsid = 1
  AND sc.id = ysw AND r.actor_key = ykey AND r.partner_system_id = ypsid
  AND r.admin_up AND r.link_up AND r.aggregatable
  AND w.admin_up AND w.link_up
  AND r.partner_system_id = sd.system_id
  AND r.partner_key = w.actor_key
WITH sxid, akey, psid, na, count(r.id) AS nb
WITH sxid, akey, psid, na,
     CASE WHEN na = nb THEN 1 ELSE 0 END AS sym
MATCH (sx:Switch)-[:HAS_PORT]->(m:Port)-[:LINK]-(mq:Port)<-[:HAS_PORT]-(mt:Switch)
WHERE sx.id = sxid AND m.actor_key = akey AND m.partner_system_id = psid
  AND m.admin_up AND m.link_up AND m.aggregatable
  AND mq.admin_up AND mq.link_up
  AND m.partner_system_id = mt.system_id
  AND m.partner_key = mq.actor_key
MATCH (sx)-[:HAS_LAG_CONFIG]->(lc:LagConfig)
WHERE lc.actor_key = akey
RETURN sx.name AS switch, m.name AS port,
       CASE WHEN sym = 0 THEN 'Individual'
            WHEN na >= 1 THEN 'Bundled'
            ELSE 'Down' END AS state,
       CASE WHEN sym = 0 THEN 'NONE'
            ELSE cast(akey AS STRING) + ':' + psid END AS lag_id
UNION ALL
MATCH (s2:Switch)-[:HAS_PORT]->(p2:Port)
OPTIONAL MATCH (p2)-[:LINK]-(q2:Port)<-[:HAS_PORT]-(t2:Switch)
WHERE p2.admin_up AND p2.link_up AND p2.aggregatable
  AND q2.admin_up AND q2.link_up
  AND p2.partner_system_id = t2.system_id
  AND p2.partner_key = q2.actor_key
WITH s2, p2, count(q2.id) AS agreeing
WHERE agreeing = 0
OPTIONAL MATCH (p2)-[:LINK]-(any:Port)
WITH s2, p2, count(any.id) AS peers
RETURN s2.name AS switch, p2.name AS port,
       CASE WHEN peers = 0 OR NOT p2.admin_up OR NOT p2.link_up
            THEN 'Detached' ELSE 'Individual' END AS state,
       'NONE' AS lag_id
