  {cl: 'dispersion-tie-name', st: 3, pe: 'pool03.bcn.example.net', tc: 3, fc: 0},
  {cl: 'eligibility-filter', st: 3, pe: 'sync04.atl.example.net', tc: 2, fc: 0},
  {cl: 'fleet-00', st: 16, pe: 'NONE', tc: 0, fc: 3},
  {cl: 'fleet-01', st: 16, pe: 'NONE', tc: 0, fc: 3},
  {cl: 'fleet-02', st: 2, pe: 'pool00.dfw.example.net', tc: 3, fc: 0},
  {cl: 'fleet-03', st: 16, pe: 'NONE', tc: 0, fc: 4},
  {cl: 'fleet-04', st: 16, pe: 'NONE', tc: 0, fc: 2},
  {cl: 'fleet-05', st: 16, pe: 'NONE', tc: 0, fc: 5},
  {cl: 'fleet-06', st: 16, pe: 'NONE', tc: 0, fc: 3},
  {cl: 'fleet-07', st: 16, pe: 'NONE', tc: 0, fc: 5},
  {cl: 'fleet-08', st: 16, pe: 'NONE', tc: 0, fc: 6},
  {cl: 'fleet-09', st: 16, pe: 'NONE', tc: 0, fc: 4},
  {cl: 'fleet-10', st: 16, pe: 'NONE', tc: 0, fc: 3},
  {cl: 'lowest-stratum-outlier', st: 5, pe: 'tick04.ams.example.net', tc: 2, fc: 1},
  {cl: 'majority-wider', st: 3, pe: 'chrony03.jfk.example.net', tc: 4, fc: 1},
  {cl: 'nested-offsets', st: 4, pe: 'ntp00.gru.example.net', tc: 3, fc: 0},
  {cl: 'one-out-of-four', st: 3, pe: 'stratum01.icn.example.net', tc: 3, fc: 1},
  {cl: 'overlap-not-offset', st: 3, pe: 'chrony04.syd.example.net', tc: 3, fc: 1},
  {cl: 'single-eligible', st: 5, pe: 'chrony01.bcn.example.net', tc: 1, fc: 0},
  {cl: 'stratum-tie-dispersion', st: 4, pe: 'tick00.hkg.example.net', tc: 3, fc: 0},
  {cl: 'tolerated-outlier', st: 3, pe: 'clock03.jfk.example.net', tc: 2, fc: 1},
  {cl: 'two-of-three', st: 3, pe: 'refclk01.yyz.example.net', tc: 2, fc: 1},
  {cl: 'zero-width', st: 3, pe: 'sync04.ams.example.net', tc: 3, fc: 0}
] AS row
RETURN row.cl AS client, row.st AS stratum, row.pe AS system_peer, row.tc AS truechimer_count, row.fc AS falseticker_count
