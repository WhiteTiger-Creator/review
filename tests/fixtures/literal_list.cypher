UNWIND [
  {cl: 'all-disjoint', st: 16, pe: 'NONE', tc: 0, fc: 3},
  {cl: 'all-unreachable', st: 16, pe: 'NONE', tc: 0, fc: 0},
  {cl: 'all-unsynchronized', st: 16, pe: 'NONE', tc: 0, fc: 0},
