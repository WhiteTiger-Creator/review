{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "evidence_fingerprint", "analysis_revision", "findings", "rejected_candidates", "nodes", "edges"],
  "properties": {
    "schema_version": {"type": "integer"},
    "evidence_fingerprint": {"type": "string"},
    "analysis_revision": {"type": "integer"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "evidence_event_ids"],
        "additionalProperties": true,
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "signing_key_reuse",
              "bearer_forwarding",
              "scope_escalation",
              "refresh_token_replay",
              "audience_confusion",
              "revocation_lag_exposure"
            ]
          },
          "evidence_event_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "rejected_candidates": {"type": "array"},
    "nodes": {"type": "array"},
    "edges": {"type": "array"},
    "legacy_compatibility": {"type": "object"}
  }
}
