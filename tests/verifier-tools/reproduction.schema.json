{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "temperature",
    "optimal_threshold",
    "holdout_n",
    "class_weights",
    "confusion_matrix",
    "macro_f1",
    "weighted_f1",
    "micro_f1",
    "brier_score",
    "ece",
    "per_class",
    "calibration_bins"
  ],
  "properties": {
    "model": { "const": "tfjs_logistic_regression" },
    "temperature": { "type": "number", "exclusiveMinimum": 0 },
    "optimal_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "holdout_n": { "type": "integer", "minimum": 1 },
    "class_weights": {
      "type": "object",
      "required": ["0", "1"],
      "properties": {
        "0": { "type": "number", "exclusiveMinimum": 0 },
        "1": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "confusion_matrix": {
      "type": "object",
      "required": ["tp", "fp", "fn", "tn"],
      "properties": {
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "tn": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "macro_f1": { "type": "number", "minimum": 0, "maximum": 1 },
    "weighted_f1": { "type": "number", "minimum": 0, "maximum": 1 },
    "micro_f1": { "type": "number", "minimum": 0, "maximum": 1 },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "ece": { "type": "number", "minimum": 0, "maximum": 1 },
    "per_class": {
      "type": "object",
      "required": ["0", "1"],
      "properties": {
        "0": {
          "type": "object",
          "required": ["precision", "recall", "f1", "support"],
          "properties": {
            "precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "f1": { "type": "number", "minimum": 0, "maximum": 1 },
            "support": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "1": {
          "type": "object",
          "required": ["precision", "recall", "f1", "support"],
          "properties": {
            "precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "f1": { "type": "number", "minimum": 0, "maximum": 1 },
            "support": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calibration_bins": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["bin_lo", "bin_hi", "predicted_mean", "observed_rate", "count"],
        "properties": {
          "bin_lo": { "type": "number" },
          "bin_hi": { "type": "number" },
          "predicted_mean": { "type": "number" },
          "observed_rate": { "type": "number" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
