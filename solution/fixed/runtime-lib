#!/usr/bin/env bash

PUBLIC_KEY=/app/packaging/release-signing.pub
LOADER_VARS=(LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT LD_DEBUG LD_ORIGIN_PATH GLIBC_TUNABLES GCONV_PATH)

fail_integrity() {
    echo "integrity: $*" >&2
    return 74
}

validate_root_arg() {
    local value=${1:-}
    if [[ "$value" != /* ]] || [ "$value" = / ]; then
        echo "root must be an absolute non-root path" >&2
        return 64
    fi
    value=${value%/}
    if [ "$(realpath -m -- "$value")" != "$value" ]; then
        echo "root must be normalized and contain no symlink components" >&2
        return 64
    fi
    printf '%s\n' "$value"
}

link_target_is_release() {
    local target=$1
    [[ "$target" == releases/* ]] && [[ "$target" != *..* ]] && [[ "$target" != */*/* ]]
}

verify_release() {
    local root=$1 release=$2 manifest id provenance attestation signature
    manifest=$release/release.manifest
    id=$release/release.id
    provenance=$release/release.provenance
    attestation=$release/release.attestation
    signature=$release/release.signature

    case "$(realpath -m -- "$release")" in "$root"/opt/ledger/releases/*) ;;
        *) fail_integrity "release escapes release root"; return;;
    esac
    [ -d "$release" ] && [ ! -L "$release" ] || { fail_integrity "release directory missing"; return; }
    local meta
    for meta in "$manifest" "$id" "$provenance" "$attestation" "$signature"; do
        [ -f "$meta" ] && [ ! -L "$meta" ] || { fail_integrity "release metadata missing or linked"; return; }
    done

    awk '
        NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-f]/ ||
        $2 !~ /^(bin|lib|requests)\// || $2 ~ /(^|\/)\.\.?(\/|$)/ || $2 ~ /^\// { bad=1 }
        END { exit bad }
    ' "$manifest" || { fail_integrity "malformed manifest"; return; }
    local listed sorted
    listed=$(awk '{print $2}' "$manifest")
    sorted=$(printf '%s\n' "$listed" | LC_ALL=C sort -u)
    [ "$listed" = "$sorted" ] || { fail_integrity "manifest paths are not sorted and unique"; return; }

    local actual_id declared_id
    actual_id=$(sha256sum "$manifest" | awk '{print $1}')
    declared_id=$(tr -d '\r\n' < "$id")
    [ ${#declared_id} -eq 64 ] && [[ "$declared_id" != *[!0-9a-f]* ]] \
        && [ "$actual_id" = "$declared_id" ] || { fail_integrity "release id mismatch"; return; }
    (cd "$release" && sha256sum -c release.manifest >/dev/null) \
        || { fail_integrity "payload checksum mismatch"; return; }

    local expected_files actual_files
    expected_files=$(printf '%s\n' "$listed")
    actual_files=$(cd "$release" && find bin lib requests -type f -printf '%p\n' | LC_ALL=C sort)
    [ "$expected_files" = "$actual_files" ] || { fail_integrity "undeclared or missing payload"; return; }

    local abi provenance_hash
    abi=$(sed -n 's/^abi //p' "$provenance")
    [ "$abi" = LEDGER_2.1 ] || { fail_integrity "provenance ABI mismatch"; return; }
    local expected_provenance
    expected_provenance=$(mktemp)
    {
        printf 'abi %s\n' "$abi"
        while IFS= read -r path; do
            if readelf -h "$release/$path" >/dev/null 2>&1; then
                local build_id
                build_id=$(readelf -n "$release/$path" | awk '/Build ID:/ {print $3; exit}')
                [ ${#build_id} -eq 40 ] && [[ "$build_id" != *[!0-9a-f]* ]] \
                    || { rm -f "$expected_provenance"; fail_integrity "ELF build identity missing"; return; }
                printf 'elf %s %s\n' "$path" "$build_id"
            fi
        done < <(cd "$release" && find bin lib -type f -printf '%p\n' | LC_ALL=C sort)
    } > "$expected_provenance"
    cmp -s "$expected_provenance" "$provenance" \
        || { rm -f "$expected_provenance"; fail_integrity "ELF provenance mismatch"; return; }
    rm -f "$expected_provenance"

    provenance_hash=$(sha256sum "$provenance" | awk '{print $1}')
    cmp -s "$attestation" <(printf 'release_id=%s\nabi=%s\nprovenance_sha256=%s\n' \
        "$declared_id" "$abi" "$provenance_hash") \
        || { fail_integrity "attestation mismatch"; return; }
    openssl pkeyutl -verify -pubin -inkey "$PUBLIC_KEY" -rawin \
        -in "$attestation" -sigfile "$signature" >/dev/null 2>&1 \
        || { fail_integrity "untrusted release signature"; return; }
}

is_valid_release() {
    verify_release "$1" "$2" >/dev/null 2>&1
}

native_env() {
    local args=(env)
    local name
    for name in "${LOADER_VARS[@]}"; do args+=( -u "$name" ); done
    "${args[@]}" "$@"
}

rehearse_release() {
    local root=$1 rel=$2 mode route
    for mode in baseline v3; do
        for route in settlement refund reconcile; do
            if [ "$mode" = baseline ]; then
                native_env chroot "$root" /lib64/ld-linux-x86-64.so.2 --inhibit-cache \
                    --library-path "$rel/lib" --glibc-hwcaps-mask "" \
                    "$rel/bin/ledger-gateway" "$rel/requests/$route.req" >/dev/null
            else
                native_env chroot "$root" /lib64/ld-linux-x86-64.so.2 --inhibit-cache \
                    --library-path "$rel/lib" --glibc-hwcaps-prepend x86-64-v3 \
                    "$rel/bin/ledger-gateway" "$rel/requests/$route.req" >/dev/null
            fi
        done
    done
}

atomic_link() {
    local target=$1 link=$2 tag=$3
    ln -s "$target" "${link}.${tag}.$$"
    mv -Tf "${link}.${tag}.$$" "$link"
}

recover_pending() {
    local root=$1 pending=$root/var/lib/ledger/activation.pending
    [ -e "$pending" ] || return 0
    [ -f "$pending" ] && [ ! -L "$pending" ] || { fail_integrity "unsafe activation record"; return; }
    local old new current
    old=$(sed -n 's/^old=//p' "$pending")
    new=$(sed -n 's/^new=//p' "$pending")
    [ -n "$new" ] && link_target_is_release "$new" \
        || { fail_integrity "malformed activation record"; return; }
    [ -z "$old" ] || link_target_is_release "$old" \
        || { fail_integrity "malformed activation predecessor"; return; }
    current=""
    [ -L "$root/opt/ledger/current" ] && current=$(readlink "$root/opt/ledger/current")
    if [ "$current" = "$new" ]; then
        if [ -n "$old" ] && is_valid_release "$root" "$root/opt/ledger/$old"; then
            atomic_link "$old" "$root/opt/ledger/previous" recovered
        else
            rm -f "$root/opt/ledger/previous"
        fi
    elif [ "$current" != "$old" ]; then
        fail_integrity "activation state disagrees with current"; return
    fi
    rm -f "$pending"
}
