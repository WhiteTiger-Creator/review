diff -ruN a/bin/reload-cache-policy b/bin/reload-cache-policy
--- a/bin/reload-cache-policy
+++ b/bin/reload-cache-policy
@@ -7,9 +7,6 @@
 # shellcheck source=/dev/null
 source "${ROOT}/policy/cache-limits.conf"
 
-# Starter reload: compile check only, activate under a non-content-addressed label.
-# Production activation must use the mv_ label from /srv/mirrorveil/bin/compute-vcl-label
-# (see /srv/mirrorveil/runbooks/invalidation-console.md).
 VCL_DIR="${ROOT}/vcl"
 ENTRY="${ENTRY_VCL}"
 
@@ -18,8 +15,31 @@
   exit 1
 fi
 
-LABEL="boot_reload"
-varnishadm -n "${VARNISH_WORK_DIR}" vcl.load "${LABEL}" "${ENTRY}" >/dev/null
-varnishadm -n "${VARNISH_WORK_DIR}" vcl.use "${LABEL}" >/dev/null
+LABEL="$("${ROOT}/bin/compute-vcl-label")"
+
+LIST="$(varnishadm -n "${VARNISH_WORK_DIR}" vcl.list 2>/dev/null || true)"
+if printf '%s\n' "${LIST}" | awk '{print $NF}' | grep -qx "${LABEL}"; then
+  varnishadm -n "${VARNISH_WORK_DIR}" vcl.use "${LABEL}" >/dev/null
+else
+  varnishadm -n "${VARNISH_WORK_DIR}" vcl.load "${LABEL}" "${ENTRY}" >/dev/null
+  varnishadm -n "${VARNISH_WORK_DIR}" vcl.use "${LABEL}" >/dev/null
+fi
+
+ACTIVE="$(varnishadm -n "${VARNISH_WORK_DIR}" vcl.list | awk '/active/ {print $NF; exit}')"
+if [[ "${ACTIVE}" != "${LABEL}" ]]; then
+  echo "failed to activate ${LABEL} (active=${ACTIVE})" >&2
+  exit 1
+fi
+
+while read -r state _rest label; do
+  [[ -n "${label}" ]] || continue
+  if [[ "${label}" == "${LABEL}" ]]; then
+    continue
+  fi
+  if [[ "${label}" == mv_* && "${state}" != "active" ]]; then
+    varnishadm -n "${VARNISH_WORK_DIR}" vcl.discard "${label}" >/dev/null 2>&1 || true
+  fi
+done < <(varnishadm -n "${VARNISH_WORK_DIR}" vcl.list | awk '{print $1, $0, $NF}')
+
 echo "active=${LABEL}"
 exit 0
diff -ruN a/vcl/delivery-state.vcl b/vcl/delivery-state.vcl
--- a/vcl/delivery-state.vcl
+++ b/vcl/delivery-state.vcl
@@ -1,9 +1,52 @@
-# Starter delivery markers: emit a fixed pass label for client visibility.
+# Client-visible cache-state headers and synthetic bodies.
 
 sub mirror_delivery_state_deliver {
-    set resp.http.X-Edge-State = "PASS";
+    unset resp.http.X-Internal-Host;
+    unset resp.http.X-Internal-Class;
+    unset resp.http.X-Internal-URL;
+    unset resp.http.X-Vary-Norm;
+
+    if (resp.status == 503 && req.http.X-Edge-State != "GRACE" && req.http.X-Edge-State != "HIT") {
+        set resp.http.X-Edge-State = "SYNTH";
+        return;
+    }
+
+    if (req.http.X-Edge-State) {
+        set resp.http.X-Edge-State = req.http.X-Edge-State;
+    } else if (obj.hits > 0) {
+        set resp.http.X-Edge-State = "HIT";
+    } else {
+        set resp.http.X-Edge-State = "MISS";
+    }
 }
 
 sub mirror_delivery_state_synth {
     set resp.http.X-Edge-State = "SYNTH";
+    set resp.http.Content-Type = "text/plain; charset=utf-8";
+
+    if (resp.status == 200 && resp.reason == "purged") {
+        synthetic({"purged"});
+        return (deliver);
+    }
+    if (resp.status == 202 && resp.reason == "ban queued") {
+        synthetic({"ban queued"});
+        return (deliver);
+    }
+    if (resp.status == 421) {
+        synthetic({"misdirected request"});
+        return (deliver);
+    }
+    if (resp.status == 405) {
+        synthetic({"method not allowed"});
+        return (deliver);
+    }
+    if (resp.status == 400) {
+        synthetic({"bad request"});
+        return (deliver);
+    }
+    if (resp.status == 503) {
+        synthetic({"service unavailable"});
+        return (deliver);
+    }
+    return (deliver);
 }
diff -ruN a/vcl/entry.vcl b/vcl/entry.vcl
--- a/vcl/entry.vcl
+++ b/vcl/entry.vcl
@@ -26,19 +26,51 @@
 
 sub vcl_hash {
     hash_data(req.url);
-    if (req.http.Host) {
-        hash_data(req.http.Host);
+    hash_data(req.http.Host);
+    if (req.http.Accept-Encoding) {
+        hash_data(req.http.Accept-Encoding);
     }
 }
 
+sub vcl_hit {
+    if (obj.ttl >= 0s) {
+        set req.http.X-Edge-State = "HIT";
+        return (deliver);
+    }
+    if (obj.ttl + obj.grace > 0s) {
+        if (!std.healthy(primary_origin) && !std.healthy(secondary_origin)) {
+            set req.http.X-Edge-State = "GRACE";
+            return (deliver);
+        }
+    }
+    set req.hash_always_miss = true;
+    return (restart);
+}
+
+sub vcl_miss {
+    set req.http.X-Edge-State = "MISS";
+}
+
+sub vcl_pass {
+    set req.http.X-Edge-State = "PASS";
+}
+
 sub vcl_backend_response {
     call mirror_object_policy_beresp;
 }
 
+sub vcl_backend_error {
+    return (abandon);
+}
+
 sub vcl_deliver {
     call mirror_delivery_state_deliver;
 }
 
 sub vcl_synth {
     call mirror_delivery_state_synth;
+}
+
+sub vcl_purge {
+    return (synth(200, "purged"));
 }
diff -ruN a/vcl/invalidation.vcl b/vcl/invalidation.vcl
--- a/vcl/invalidation.vcl
+++ b/vcl/invalidation.vcl
@@ -1,10 +1,42 @@
-# Starter invalidation: reject administrative methods without mutating cache state.
+# Administrative PURGE and class BAN over the HTTP control path.
 
 sub mirror_invalidate_recv {
     if (req.method == "PURGE" || req.method == "BAN") {
-        if (client.ip !~ mirror_loopback) {
+        if (client.ip !~ mirror_loopback ||
+            req.http.X-Mirror-Control != "mv-ctrl-9e4b7a1c2d8f6035") {
             return (synth(405, "Method Not Allowed"));
         }
-        return (synth(405, "Method Not Allowed"));
+        if (!req.http.Host || req.http.Host ~ "[[:space:]]" || req.http.Host ~ ",") {
+            return (synth(405, "Method Not Allowed"));
+        }
+        set req.http.Host = regsub(req.http.Host, ":[0-9]+$", "");
+        set req.http.Host = std.tolower(req.http.Host);
+        if (req.http.Host != "releases.aurora.invalid" &&
+            req.http.Host != "releases.basalt.invalid") {
+            return (synth(405, "Method Not Allowed"));
+        }
+        if (req.url ~ "\?$") {
+            set req.url = regsub(req.url, "\?$", "");
+        }
+        set req.url = std.querysort(req.url);
+
+        if (req.method == "PURGE") {
+            unset req.http.X-Mirror-Control;
+            unset req.http.X-Ban-Class;
+            return (purge);
+        }
+
+        if (!req.http.X-Ban-Class ||
+            (req.http.X-Ban-Class != "stable" &&
+             req.http.X-Ban-Class != "candidate" &&
+             req.http.X-Ban-Class != "metadata" &&
+             req.http.X-Ban-Class != "large")) {
+            return (synth(400, "Bad Request"));
+        }
+
+        ban("obj.http.X-Internal-Host == " + req.http.Host + " && obj.http.X-Internal-Class == " + req.http.X-Ban-Class);
+        unset req.http.X-Mirror-Control;
+        unset req.http.X-Ban-Class;
+        return (synth(202, "ban queued"));
     }
 }
diff -ruN a/vcl/object-policy.vcl b/vcl/object-policy.vcl
--- a/vcl/object-policy.vcl
+++ b/vcl/object-policy.vcl
@@ -1,9 +1,55 @@
-# Starter object policy: do not retain shared objects.
+# Object storage eligibility, grace/keep windows, and internal ban metadata.
 
 sub mirror_object_policy_beresp {
-    set beresp.uncacheable = true;
-    set beresp.ttl = 0s;
-    set beresp.grace = 0s;
-    set beresp.keep = 0s;
+    set beresp.grace = 5s;
+    set beresp.keep = 20s;
+
+    if (beresp.status != 200) {
+        set beresp.uncacheable = true;
+        set beresp.ttl = 0s;
+        return (deliver);
+    }
+
+    if (beresp.http.Set-Cookie) {
+        set beresp.uncacheable = true;
+        set beresp.ttl = 0s;
+        return (deliver);
+    }
+
+    if (beresp.http.Cache-Control ~ "(?i)private" ||
+        beresp.http.Cache-Control ~ "(?i)no-store" ||
+        beresp.http.Cache-Control ~ "(?i)no-cache") {
+        set beresp.uncacheable = true;
+        set beresp.ttl = 0s;
+        return (deliver);
+    }
+
+    if (beresp.http.Vary) {
+        set beresp.http.X-Vary-Norm = regsuball(beresp.http.Vary, "^[ \\t]+|[ \\t]+$", "");
+        set beresp.http.X-Vary-Norm = std.tolower(beresp.http.X-Vary-Norm);
+        if (beresp.http.X-Vary-Norm == "*" ||
+            beresp.http.X-Vary-Norm != "accept-encoding") {
+            unset beresp.http.X-Vary-Norm;
+            set beresp.uncacheable = true;
+            set beresp.ttl = 0s;
+            return (deliver);
+        }
+        unset beresp.http.X-Vary-Norm;
+    }
+
+    if (beresp.http.X-Artifact-Class != "stable" &&
+        beresp.http.X-Artifact-Class != "candidate" &&
+        beresp.http.X-Artifact-Class != "metadata" &&
+        beresp.http.X-Artifact-Class != "large") {
+        set beresp.uncacheable = true;
+        set beresp.ttl = 0s;
+        return (deliver);
+    }
+
+    set beresp.do_stream = true;
+
+    set beresp.http.X-Internal-Host = bereq.http.Host;
+    set beresp.http.X-Internal-Class = beresp.http.X-Artifact-Class;
+    set beresp.http.X-Internal-URL = bereq.url;
     return (deliver);
 }
diff -ruN a/vcl/request-boundary.vcl b/vcl/request-boundary.vcl
--- a/vcl/request-boundary.vcl
+++ b/vcl/request-boundary.vcl
@@ -1,12 +1,44 @@
-# Starter request boundary: route ordinary traffic without scored edge policy.
+# Request boundary: hosts, normalization, method and forced-pass rules.
 
 sub mirror_request_boundary_recv {
     unset req.http.X-Mirror-Control;
     unset req.http.X-Ban-Class;
 
+    if (!req.http.Host || req.http.Host ~ "[[:space:]]" || req.http.Host ~ ",") {
+        return (synth(421, "Misdirected Request"));
+    }
+
+    set req.http.Host = regsub(req.http.Host, ":[0-9]+$", "");
+    set req.http.Host = std.tolower(req.http.Host);
+
+    if (req.http.Host != "releases.aurora.invalid" &&
+        req.http.Host != "releases.basalt.invalid") {
+        return (synth(421, "Misdirected Request"));
+    }
+
+    if (req.url ~ "\?$") {
+        set req.url = regsub(req.url, "\?$", "");
+    }
+    set req.url = std.querysort(req.url);
+
+    if (req.http.Accept-Encoding ~ "(?i)gzip") {
+        set req.http.Accept-Encoding = "gzip";
+    } else {
+        unset req.http.Accept-Encoding;
+    }
+
     if (req.method != "GET" && req.method != "HEAD") {
         return (pass);
     }
 
-    return (pass);
+    if (req.http.Authorization ||
+        req.http.Cookie ||
+        req.http.Range ||
+        req.http.Cache-Control ~ "(?i)no-cache" ||
+        req.http.Cache-Control ~ "(?i)no-store" ||
+        req.http.Pragma ~ "(?i)no-cache") {
+        return (pass);
+    }
+
+    return (hash);
 }
