+	out.Payment = &p
+	return out, nil
+}
+
+// ------------------------------------------------------------------ shapes ----
+
+func isChi(s []int) bool {
+	return len(s) == 3 && s[0]+1 == s[1] && s[1]+1 == s[2] && !tiles.IsHonour(s[2])
+}
+
+func isPon(s []int) bool { return len(s) == 3 && s[0] == s[1] && s[1] == s[2] }
+
+func isKan(s []int) bool { return len(s) == 4 }
+
+func isPonOrKan(s []int) bool { return isPon(s) || isKan(s) }
+
+func isPair(s []int) bool { return len(s) == 2 }
+
+func filter(hand [][]int, pred func([]int) bool) [][]int {
+	var out [][]int
+	for _, s := range hand {
+		if pred(s) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+func sameSet(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func allTiles(hand [][]int) []int {
+	var out []int
+	for _, s := range hand {
+		out = append(out, s...)
+	}
+	return out
+}
+
+func allOf(hand [][]int, pred func(int) bool) bool {
+	for _, t := range allTiles(hand) {
+		if !pred(t) {
+			return false
+		}
+	}
+	return true
+}
+
+func allSimples(hand [][]int) bool {
+	return allOf(hand, func(t int) bool { return !tiles.IsHonour(t) && !tiles.IsTerminal(t) })
+}
+
+func oneSuitOnly(hand [][]int, withHonours bool) bool {
+	suits := map[int]bool{}
+	honours := 0
+	for _, s := range hand {
+		if tiles.IsHonour(s[0]) {
+			honours++
+			continue
+		}
+		suits[tiles.Suit(s[0])] = true
+	}
+	if len(suits) != 1 {
+		return false
+	}
+	if withHonours {
+		return honours != 0
+	}
+	return honours == 0
+}
+
+func isChantai(hand [][]int) bool {
+	terminalSets, honourSets, chi := 0, 0, 0
+	for _, s := range hand {
+		if isChi(s) {
+			chi++
+		}
+		if anyOf(s, tiles.IsTerminal) {
+			terminalSets++
+		}
+		if anyOf(s, tiles.IsHonour) {
+			honourSets++
+		}
+	}
+	if chi == 0 {
+		return false
+	}
+	return terminalSets+honourSets == 5 && terminalSets != 0 && honourSets != 0
+}
+
+func isJunchan(hand [][]int) bool {
+	terminalSets, chi := 0, 0
+	for _, s := range hand {
+		if isChi(s) {
+			chi++
+		}
+		if anyOf(s, tiles.IsTerminal) {
+			terminalSets++
+		}
+	}
+	return chi != 0 && terminalSets == 5
+}
+
+func anyOf(set []int, pred func(int) bool) bool {
+	for _, t := range set {
+		if pred(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func isIttsu(chis [][]int) bool {
+	if len(chis) < 3 {
+		return false
+	}
+	for suit := 0; suit < 3; suit++ {
+		starts := map[int]bool{}
+		for _, s := range chis {
+			if tiles.Suit(s[0]) == suit {
+				starts[tiles.Rank(s[0])] = true
+			}
+		}
+		if starts[0] && starts[3] && starts[6] {
+			return true
+		}
+	}
+	return false
+}
+
+func isSanshoku(chis [][]int) bool {
+	for _, a := range chis {
+		for _, b := range chis {
+			for _, c := range chis {
+				if tiles.Suit(a[0]) == 0 && tiles.Suit(b[0]) == 1 && tiles.Suit(c[0]) == 2 &&
+					tiles.Rank(a[0]) == tiles.Rank(b[0]) && tiles.Rank(b[0]) == tiles.Rank(c[0]) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func isSanshokuDouko(pons [][]int) bool {
+	if len(pons) < 3 {
+		return false
+	}
+	for _, a := range pons {
+		for _, b := range pons {
+			for _, c := range pons {
+				if tiles.Suit(a[0]) == 0 && tiles.Suit(b[0]) == 1 && tiles.Suit(c[0]) == 2 &&
+					tiles.Rank(a[0]) == tiles.Rank(b[0]) && tiles.Rank(b[0]) == tiles.Rank(c[0]) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func identicalRuns(chis [][]int) int {
+	best := 0
+	for _, a := range chis {
+		n := 0
+		for _, b := range chis {
+			if sameSet(a, b) {
+				n++
+			}
+		}
+		if n > best {
+			best = n
+		}
+	}
+	return best
+}
+
+// identicalRunMembers counts runs that appear at least twice in the hand.
+func identicalRunMembers(chis [][]int) int {
+	n := 0
+	for _, a := range chis {
+		count := 0
+		for _, b := range chis {
+			if sameSet(a, b) {
+				count++
+			}
+		}
+		if count >= 2 {
+			n++
+		}
+	}
+	return n
+}
+
+func hasSet(hand [][]int, tile int) bool {
+	n := 0
+	for _, s := range hand {
+		if isPonOrKan(s) && s[0] == tile {
+			n++
+		}
+	}
+	return n == 1
+}
+
+func countSets(hand [][]int, group []int) int {
+	n := 0
+	for _, s := range hand {
+		if !isPonOrKan(s) {
+			continue
+		}
+		for _, t := range group {
+			if s[0] == t {
+				n++
+			}
+		}
+	}
+	return n
+}
+
+func dragonSets(hand [][]int) int {
+	n := 0
+	for _, s := range hand {
+		if (isPair(s) || isPonOrKan(s)) && (s[0] == tiles.White || s[0] == tiles.Green || s[0] == tiles.Red) {
+			n++
+		}
+	}
+	return n
+}
+
+func hasDragonPair(hand [][]int) bool {
+	for _, s := range hand {
+		if isPair(s) && (s[0] == tiles.White || s[0] == tiles.Green || s[0] == tiles.Red) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasWindPair(hand [][]int) bool {
+	for _, s := range hand {
+		if isPair(s) && s[0] >= tiles.East && s[0] <= tiles.North {
+			return true
+		}
+	}
+	return false
+}
+
+func quads(melds []meld) int {
+	n := 0
+	for _, m := range melds {
+		if m.kind == "kan" {
+			n++
+		}
+	}
+	return n
+}
+
+func concealedTriplets(hand [][]int, winTile int, openedSets [][]int, selfDraw bool) int {
+	opened := copySets(openedSets)
+	var winChis [][]int
+	for _, s := range hand {
+		if isChi(s) && contains(s, winTile) && !inSets(opened, s) {
+			winChis = append(winChis, s)
+		}
+	}
+	closed := 0
+	for _, s := range hand {
+		if !isPonOrKan(s) {
+			continue
+		}
+		if inSets(opened, s) {
+			continue
+		}
+		if contains(s, winTile) && !selfDraw && len(winChis) == 0 {
+			continue
+		}
+		closed++
+	}
+	return closed
+}
+
+func concealedForSuuankou(hand [][]int, winTile int, selfDraw bool) int {
+	n := 0
+	for _, s := range hand {
+		if isPonOrKan(s) && contains(s, winTile) && !selfDraw {
+			continue
+		}
+		if isPonOrKan(s) {
+			n++
+		}
+	}
+	return n
+}
+
+func isChuuren(hand [][]int) bool {
+	if !oneSuitOnly(hand, false) {
+		return false
+	}
+	ranks := map[int]int{}
+	for _, t := range allTiles(hand) {
+		ranks[tiles.Rank(t)]++
+	}
+	if ranks[0] < 3 || ranks[8] < 3 {
+		return false
+	}
+	left := map[int]int{}
+	for k, v := range ranks {
+		left[k] = v
+	}
+	left[0] -= 2
+	left[8] -= 2
+	for r := 0; r < 9; r++ {
+		if left[r] > 0 {
+			left[r]--
+		}
+	}
+	total := 0
+	for _, v := range left {
+		total += v
+	}
+	return total == 1
+}
+
+func isThirteenOrphans(counts [tiles.Count]int) bool {
+	product := 1
+	for _, t := range append(append([]int{}, tiles.Terminals...), tiles.Honours...) {
+		product *= counts[t]
+	}
+	return product == 2
+}
+
+func contains(set []int, tile int) bool {
+	for _, t := range set {
+		if t == tile {
+			return true
+		}
+	}
+	return false
+}
+
+func indexOf(set []int, tile int) int {
+	for i, t := range set {
+		if t == tile {
+			return i
+		}
+	}
+	return -1
+}
+
+func copySets(in [][]int) [][]int {
+	out := make([][]int, len(in))
+	for i, s := range in {
+		out[i] = append([]int(nil), s...)
+	}
+	return out
+}
+
+// inSets reports membership and removes nothing.
+func inSets(sets [][]int, set []int) bool {
+	for _, s := range sets {
+		if sameSet(s, set) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------- win group ---
+
+func winGroups(hand [][]int, openedSets [][]int, winTile int) [][]int {
+	remaining := copySets(openedSets)
+	var closed [][]int
+	for _, s := range hand {
+		matched := -1
+		for i, o := range remaining {
+			if sameSet(o, s) {
+				matched = i
+				break
+			}
+		}
+		if matched >= 0 {
+			remaining = append(remaining[:matched], remaining[matched+1:]...)
+			continue
+		}
+		closed = append(closed, s)
+	}
+	var out [][]int
+	for _, s := range closed {
+		if contains(s, winTile) && !inSets(out, s) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------- fu -----
+
+func handFu(hand [][]int, winTile int, winGroup []int, melds []meld, valued []int,
+	selfDraw, isOpen bool) ([]int, int) {
+	if len(hand) == 7 {
+		return []int{25}, 25
+	}
+	var details []int
+	var pair []int
+	for _, s := range hand {
+		if isPair(s) {
+			pair = s
+			break
+		}
+	}
+
+	openChis := [][]int{}
+	for _, m := range melds {
+		if m.kind == "chi" {
+			openChis = append(openChis, m.tiles)
+		}
+	}
+	var notOpenChi [][]int
+	remaining := copySets(openChis)
+	for _, s := range hand {
+		matched := -1
+		for i, o := range remaining {
+			if sameSet(o, s) {
+				matched = i
+				break
+			}
+		}
+		if matched >= 0 {
+			remaining = append(remaining[:matched], remaining[matched+1:]...)
+			continue
+		}
+		notOpenChi = append(notOpenChi, s)
+	}
+
+	if inSets(notOpenChi, winGroup) {
+		rank := tiles.Rank(winTile)
+		if anyOf(winGroup, tiles.IsTerminal) {
+			if rank == 2 && indexOf(winGroup, winTile) == 2 {
+				details = append(details, 2)
+			} else if rank == 6 && indexOf(winGroup, winTile) == 0 {
+				details = append(details, 2)
+			}
+		}
+		if indexOf(winGroup, winTile) == 1 {
+			details = append(details, 2)
+		}
+	}
+
+	valuedCount := 0
+	for _, v := range valued {
+		if v == pair[0] {
+			valuedCount++
+		}
+	}
+	if valuedCount == 1 {
+		details = append(details, 2)
+	}
+	if valuedCount == 2 {
+		details = append(details, 4)
+	}
+
+	if isPair(winGroup) {
+		details = append(details, 2)
+	}
+
+	for _, s := range hand {
+		if !isPonOrKan(s) {
+			continue
+		}
+		var owner *meld
+		for i := range melds {
+			if sameSet(melds[i].tiles, s) {
+				owner = &melds[i]
+				break
+			}
+		}
+		wasOpen := owner != nil && owner.open
+		isQuad := owner != nil && owner.kind == "kan"
+		strong := tiles.IsTerminal(s[0]) || tiles.IsHonour(s[0])
+		if !selfDraw && sameSet(s, winGroup) {
+			wasOpen = true
+		}
+		switch {
+		case strong && isQuad && wasOpen:
+			details = append(details, 16)
+		case strong && isQuad:
+			details = append(details, 32)
+		case strong && wasOpen:
+			details = append(details, 4)
+		case strong:
+			details = append(details, 8)
+		case isQuad && wasOpen:
+			details = append(details, 8)
+		case isQuad:
+			details = append(details, 16)
+		case wasOpen:
+			details = append(details, 2)
+		default:
+			details = append(details, 4)
+		}
+	}
+
+	if selfDraw && len(details) > 0 {
+		details = append(details, 2)
+	}
+	if isOpen && len(details) == 0 {
+		details = append(details, 2)
+	}
+	if isOpen || selfDraw {
+		details = append(details, 20)
+	} else {
+		details = append(details, 30)
+	}
+	sum := 0
+	for _, d := range details {
+		sum += d
+	}
+	return details, (sum + 9) / 10 * 10
+}
+
+// ------------------------------------------------------------------- dora -----
+
+func isDora(tile, indicator int) bool {
+	if tile < tiles.East {
+		d := indicator
+		switch d {
+		case 8:
+			d = -1
+		case 17:
+			d = 8
+		case 26:
+			d = 17
+		}
+		return tile == d+1
+	}
+	if indicator < tiles.East {
+		return false
+	}
+	d := indicator - tiles.East
+	t := tile - tiles.East
+	if d == 3 {
+		d = -1
+	}
+	if d == 6 {
+		d = 3
+	}
+	return t == d+1
+}
+
+// ------------------------------------------------------------------ payout ----
+
+func payout(han, fu int, selfDraw, dealer bool, honba, sticks int, isLimit bool) table.Payment {
+	var rounded, doubleRounded, fourRounded, sixRounded int
+	if han >= 13 && !isLimit {
+		han = 13
+	}
+	if han >= 5 {
+		switch {
+		case han >= 78:
+			rounded = 48000
+		case han >= 65:
+			rounded = 40000
+		case han >= 52:
+			rounded = 32000
+		case han >= 39:
+			rounded = 24000
+		case han >= 26:
+			rounded = 16000
+		case han >= 13:
+			rounded = 8000
+		case han >= 11:
+			rounded = 6000
+		case han >= 8:
+			rounded = 4000
+		case han >= 6:
+			rounded = 3000
+		default:
+			rounded = 2000
+		}
+		doubleRounded = rounded * 2
+		fourRounded = doubleRounded * 2
+		sixRounded = doubleRounded * 3
+	} else {
+		base := fu << (2 + han)
+		rounded = ceil100(base)
+		doubleRounded = ceil100(2 * base)
+		fourRounded = ceil100(4 * base)
+		sixRounded = ceil100(6 * base)
+		if rounded > 2000 {
+			rounded = 2000
+			doubleRounded = rounded * 2
+			fourRounded = doubleRounded * 2
+			sixRounded = doubleRounded * 3
+		}
+	}
+
+	var p table.Payment
+	if selfDraw {
+		p.Main = doubleRounded
+		p.MainBonus = 100 * honba
+		p.AdditionalBonus = p.MainBonus
+		if dealer {
+			p.Additional = p.Main
+		} else {
+			p.Additional = rounded
+		}
+	} else {
+		p.Additional = 0
+		p.AdditionalBonus = 0
+		p.MainBonus = 300 * honba
+		if dealer {
+			p.Main = sixRounded
+		} else {
+			p.Main = fourRounded
+		}
+	}
+	p.RiichiSticks = 1000 * sticks
+	p.Total = (p.Main + p.MainBonus) + 2*(p.Additional+p.AdditionalBonus) + p.RiichiSticks
+	return p
+}
+
+func ceil100(n int) int { return (n + 99) / 100 * 100 }
+
+// ---------------------------------------------------------------- dividing ----
+
+func divide(counts [tiles.Count]int, melds []meld) [][][]int {
+	closed := counts
+	for _, m := range melds {
+		for _, t := range m.tiles {
+			closed[t]--
+		}
+	}
+	var pairIndices []int
+	for t := 0; t < tiles.Count; t++ {
+		if tiles.IsHonour(t) {
+			if closed[t] == 2 {
+				pairIndices = append(pairIndices, t)
+			}
+			continue
+		}
+		if closed[t] >= 2 {
+			pairIndices = append(pairIndices, t)
+		}
+	}
+
+	var hands [][][]int
+	for _, pair := range pairIndices {
+		local := closed
+		local[pair] -= 2
+		options := [][][][]int{}
+		ok := true
+		for suit := 0; suit < 3; suit++ {
+			var cnt [9]int
+			total := 0
+			for r := 0; r < 9; r++ {
+				cnt[r] = local[suit*9+r]
+				total += cnt[r]
+			}
+			if total == 0 {
+				continue
+			}
+			parts := suitPartitions(cnt, suit*9)
+			if len(parts) == 0 {
+				ok = false
+				break
+			}
+			options = append(options, parts)
+		}
+		if !ok {
+			continue
+		}
+		var honourSets [][]int
+		for _, t := range tiles.Honours {
+			switch local[t] {
+			case 0:
+			case 3:
+				honourSets = append(honourSets, []int{t, t, t})
+			default:
+				ok = false
+			}
+		}
+		if !ok {
+			continue
+		}
+
+		base := [][]int{{pair, pair}}
+		base = append(base, honourSets...)
+		for _, m := range melds {
+			base = append(base, m.tiles)
+		}
+		for _, combo := range product(options) {
+			hand := append(copySets(base), copySets(combo)...)
+			if len(hand) != 5 {
+				continue
+			}
+			sortHand(hand)
+			if !hasHand(hands, hand) {
+				hands = append(hands, hand)
+			}
+		}
+	}
+
+	if len(pairIndices) == 7 {
+		var hand [][]int
+		for _, t := range pairIndices {
+			hand = append(hand, []int{t, t})
+		}
+		hands = append(hands, hand)
+	}
+
+	sort.SliceStable(hands, func(i, j int) bool { return handLess(hands[i], hands[j]) })
+	return hands
+}
+
+func suitPartitions(cnt [9]int, base int) [][][]int {
+	total := 0
+	for _, c := range cnt {
+		total += c
+	}
+	if total%3 != 0 {
+		return nil
+	}
+	if total == 0 {
+		return [][][]int{{}}
+	}
+	first := -1
+	for r := 0; r < 9; r++ {
+		if cnt[r] > 0 {
+			first = r
+			break
+		}
+	}
+	var out [][][]int
+	if cnt[first] >= 3 {
+		next := cnt
+		next[first] -= 3
+		for _, rest := range suitPartitions(next, base) {
+			set := []int{base + first, base + first, base + first}
+			out = append(out, append([][]int{set}, rest...))
+		}
+	}
+	if first <= 6 && cnt[first] > 0 && cnt[first+1] > 0 && cnt[first+2] > 0 {
+		next := cnt
+		next[first]--
+		next[first+1]--
+		next[first+2]--
+		for _, rest := range suitPartitions(next, base) {
+			set := []int{base + first, base + first + 1, base + first + 2}
+			out = append(out, append([][]int{set}, rest...))
+		}
+	}
+	return out
+}
+
+func product(options [][][][]int) [][][]int {
+	result := [][][]int{{}}
+	for _, group := range options {
+		var next [][][]int
+		for _, prefix := range result {
+			for _, choice := range group {
+				combined := append(copySets(prefix), copySets(choice)...)
+				next = append(next, combined)
+			}
+		}
+		result = next
+	}
+	return result
+}
+
+func sortHand(hand [][]int) {
+	sort.SliceStable(hand, func(i, j int) bool {
+		if hand[i][0] != hand[j][0] {
+			return hand[i][0] < hand[j][0]
+		}
+		return len(hand[i]) < len(hand[j])
+	})
+}
+
+func handLess(a, b [][]int) bool {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		for j := 0; j < len(a[i]) && j < len(b[i]); j++ {
+			if a[i][j] != b[i][j] {
+				return a[i][j] < b[i][j]
+			}
+		}
+		if len(a[i]) != len(b[i]) {
+			return len(a[i]) < len(b[i])
+		}
+	}
+	return len(a) < len(b)
+}
+
+func hasHand(hands [][][]int, hand [][]int) bool {
+	for _, h := range hands {
+		if len(h) != len(hand) {
+			continue
+		}
+		same := true
+		for i := range h {
+			if !sameSet(h[i], hand[i]) {
+				same = false
+				break
+			}
+		}
+		if same {
+			return true
+		}
+	}
+	return false
 }
