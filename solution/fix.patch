+	sort.SliceStable(candidates, func(i, j int) bool {
+		if candidates[i].han != candidates[j].han {
+			return candidates[i].han > candidates[j].han
+		}
+		return candidates[i].fu > candidates[j].fu
+	})
+	top := candidates[0]
+	var tied []candidate
+	for _, c := range candidates {
+		if c.han == top.han && c.fu == top.fu {
+			tied = append(tied, c)
+		}
+	}
+	sort.SliceStable(tied, func(i, j int) bool { return tied[i].fuSum > tied[j].fuSum })
+	chosen := tied[0]
