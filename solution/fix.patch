+	out := table.Result{ID: h.ID, Yaku: []string{}}
+	if !chosen.scored {
+		return out, nil
+	}
+	names := append([]string(nil), chosen.yaku...)
+	sort.Strings(names)
+	out.Scored = true
+	out.Han = chosen.han
+	out.Fu = chosen.fu
+	out.Yaku = names
