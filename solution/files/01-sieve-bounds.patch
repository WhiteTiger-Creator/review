--- /dev/null
+++ b/internal/sieve/bounds.go
@@ -0,0 +1,115 @@
+// Package sieve parses the five range forms and answers whether a version
+// satisfies them.
+package sieve
+
+import (
+	"fmt"
+	"strings"
+
+	"slate/internal/semver"
+)
+
+type kind int
+
+const (
+	kindAny kind = iota
+	kindExact
+	kindSpan
+)
+
+// Range is a parsed range.
+type Range struct {
+	text     string
+	kind     kind
+	exact    semver.Version
+	lower    semver.Version
+	upper    semver.Version
+	preCores []semver.Version
+}
+
+// Text returns the range as written.
+func (r Range) Text() string { return r.text }
+
+// Parse reads one range. The text is kept so errors can quote it.
+func Parse(text string) (Range, error) {
+	r := Range{text: text}
+	fields := strings.Fields(text)
+	if len(fields) == 0 {
+		return r, fmt.Errorf("empty range")
+	}
+	if len(fields) == 2 {
+		if !strings.HasPrefix(fields[0], ">=") || !strings.HasPrefix(fields[1], "<") {
+			return r, fmt.Errorf("range %q: two-bound ranges are written >=A <B", text)
+		}
+		lower, err := semver.Parse(strings.TrimPrefix(fields[0], ">="))
+		if err != nil {
+			return r, fmt.Errorf("range %q: %w", text, err)
+		}
+		upper, err := semver.Parse(strings.TrimPrefix(fields[1], "<"))
+		if err != nil {
+			return r, fmt.Errorf("range %q: %w", text, err)
+		}
+		r.kind, r.lower, r.upper = kindSpan, lower, upper
+		r.preCores = prereleaseCores(lower, upper)
+		return r, nil
+	}
+	if len(fields) != 1 {
+		return r, fmt.Errorf("range %q: unknown form", text)
+	}
+	token := fields[0]
+	switch {
+	case token == "*":
+		r.kind = kindAny
+		return r, nil
+	case strings.HasPrefix(token, "="):
+		v, err := semver.Parse(strings.TrimPrefix(token, "="))
+		if err != nil {
+			return r, fmt.Errorf("range %q: %w", text, err)
+		}
+		r.kind, r.exact = kindExact, v
+		r.preCores = prereleaseCores(v)
+		return r, nil
+	case strings.HasPrefix(token, "^"):
+		v, err := semver.Parse(strings.TrimPrefix(token, "^"))
+		if err != nil {
+			return r, fmt.Errorf("range %q: %w", text, err)
+		}
+		r.kind, r.lower, r.upper = kindSpan, v, caretUpper(v)
+		r.preCores = prereleaseCores(v)
+		return r, nil
+	case strings.HasPrefix(token, "~"):
+		v, err := semver.Parse(strings.TrimPrefix(token, "~"))
+		if err != nil {
+			return r, fmt.Errorf("range %q: %w", text, err)
+		}
+		r.kind = kindSpan
+		r.lower = v
+		r.upper = semver.Version{Major: v.Major, Minor: v.Minor + 1, Patch: 0}
+		r.preCores = prereleaseCores(v)
+		return r, nil
+	}
+	return r, fmt.Errorf("range %q: unknown form", text)
+}
+
+// caretUpper is the exclusive upper bound of ^v: the next value of the leading
+// non-zero field.
+func caretUpper(v semver.Version) semver.Version {
+	switch {
+	case v.Major > 0:
+		return semver.Version{Major: v.Major + 1}
+	case v.Minor > 0:
+		return semver.Version{Minor: v.Minor + 1}
+	}
+	return semver.Version{Patch: v.Patch + 1}
+}
+
+// prereleaseCores collects the cores of the literals that carry an -rc. marker.
+func prereleaseCores(vs ...semver.Version) []semver.Version {
+	var out []semver.Version
+	for _, v := range vs {
+		if v.IsPrerelease() {
+			out = append(out, v.Core())
+		}
+	}
+	return out
+}
