diff -ruN before/internal/corpus/relevant.go after/internal/corpus/relevant.go
--- before/internal/corpus/relevant.go	1970-01-01 00:00:00.000000000 +0000
+++ after/internal/corpus/relevant.go	2026-07-28 08:45:35.420524538 +0000
@@ -0,0 +1,98 @@
+package corpus
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+func CommittedShards(eventsDir string) ([]string, error) {
+	entries, err := os.ReadDir(eventsDir)
+	if err != nil {
+		return nil, err
+	}
+	var shards []string
+	for _, e := range entries {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".ndjson") {
+			continue
+		}
+		shards = append(shards, e.Name())
+	}
+	sort.Strings(shards)
+	return shards, nil
+}
+
+func RelevantFingerprint(eventsDir, configDir string, events []map[string]any) (string, error) {
+	h := sha256.New()
+	shards, err := CommittedShards(eventsDir)
+	if err != nil {
+		return "", err
+	}
+	for _, name := range shards {
+		b, err := os.ReadFile(filepath.Join(eventsDir, name))
+		if err != nil {
+			return "", err
+		}
+		sum := sha256.Sum256(b)
+		_, _ = h.Write([]byte(name))
+		_, _ = h.Write(sum[:])
+	}
+	for _, rel := range []string{
+		"collectors.json",
+		"trust-boundaries.json",
+		"policy-revisions.json",
+		"scope-catalog.json",
+		"publication.json",
+	} {
+		b, err := os.ReadFile(filepath.Join(configDir, rel))
+		if err != nil {
+			return "", err
+		}
+		sum := sha256.Sum256(b)
+		_, _ = h.Write([]byte(rel))
+		_, _ = h.Write(sum[:])
+	}
+	used := usedKeyMaterial(events)
+	for _, item := range used {
+		_, _ = h.Write([]byte(item))
+		_, _ = h.Write([]byte{0})
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func usedKeyMaterial(events []map[string]any) []string {
+	seen := map[string]struct{}{}
+	var out []string
+	for _, ev := range events {
+		if fmt.Sprintf("%v", ev["event_type"]) != "token_issued" {
+			continue
+		}
+		payload, _ := ev["payload"].(map[string]any)
+		if payload == nil {
+			continue
+		}
+		issuer := fmt.Sprintf("%v", payload["issuer"])
+		material := fmt.Sprintf("%v", payload["material_id"])
+		kid := fmt.Sprintf("%v", payload["kid"])
+		if material == "" && kid == "" {
+			continue
+		}
+		key := issuer + "|" + material + "|" + kid
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func CheckpointID(evidenceFP, relevantFP string) string {
+	sum := sha256.Sum256([]byte(evidenceFP + "|" + relevantFP))
+	return hex.EncodeToString(sum[:16])
+}
diff -ruN before/internal/corpus/schema.go after/internal/corpus/schema.go
--- before/internal/corpus/schema.go	1970-01-01 00:00:00.000000000 +0000
+++ after/internal/corpus/schema.go	2026-07-28 08:37:12.355540544 +0000
@@ -0,0 +1,38 @@
+package corpus
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+func ValidateReportSchema(report map[string]any, schemaPath string) error {
+	schemaBytes, err := os.ReadFile(schemaPath)
+	if err != nil {
+		return err
+	}
+	var schema map[string]any
+	if err := json.Unmarshal(schemaBytes, &schema); err != nil {
+		return err
+	}
+	required, _ := schema["required"].([]any)
+	for _, raw := range required {
+		key, _ := raw.(string)
+		if key == "" {
+			continue
+		}
+		if _, ok := report[key]; !ok {
+			return fmt.Errorf("report missing required field %s", key)
+		}
+	}
+	if sv, ok := report["schema_version"].(float64); !ok || int(sv) != 2 {
+		if iv, ok := report["schema_version"].(json.Number); ok {
+			if n, err := iv.Int64(); err != nil || n != 2 {
+				return fmt.Errorf("invalid schema_version")
+			}
+		} else if iv, ok := report["schema_version"].(int); !ok || iv != 2 {
+			return fmt.Errorf("invalid schema_version")
+		}
+	}
+	return nil
+}
